{
  "name": "pi-setup",
  "version": "0.1.0",
  "description": "Unified Pi package for skills and extensions",
  "private": true,
  "type": "module",
  "dependencies": {
    "lighthouse": "^13.6.0"
  },
  "license": "MIT",
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "setup": "./scripts/setup.sh",
    "setup:remove": "./scripts/setup.sh --remove",
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "test": "node --experimental-strip-types --test \"extensions/*/tests/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.5.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@eslint/js": "^10",
    "@types/node": "^26",
    "eslint": "^10",
    "prettier": "^3",
    "typebox": "^1.4.4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
