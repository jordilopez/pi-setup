{
  "name": "pi-setup",
  "version": "0.1.0",
  "description": "Unified Pi package for skills, extensions, agents, and workflows",
  "private": true,
  "type": "module",
  "license": "MIT",
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./workflows"
    ]
  },
  "scripts": {
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "eslint": "^9",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
